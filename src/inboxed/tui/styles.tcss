/* ── App-level tab layout ─────────────────────────────────────────────────── */
Screen { background: $surface; }
TabbedContent { height: 1fr; }
TabbedContent ContentSwitcher { height: 1fr; }
TabPane { height: 1fr; padding: 0; }

/* Workspace tab fills the pane */
WorkspaceScreen { height: 1fr; layout: vertical; }

/* Quiet outlined buttons: accent color belongs to text and border, not the fill. */
Button {
    height: 3;
    min-height: 3;
    min-width: 10;
    padding: 0 1;
    border: round $foreground 20% !important;
    background: $surface !important;
    color: $text;
    text-style: none;
    background-tint: $background 0%;
}
Button:hover { background: $surface !important; border: round $foreground 35% !important; }
Button:focus { border: round $foreground 70% !important; text-style: bold; }
Button.-primary { color: $text-primary; border: round $primary 55% !important; }
Button.-success { color: $text-success; border: round $success 55% !important; }
Button.-warning { color: $text-warning; border: round $warning 55% !important; }
Button.-error { color: $text-error; border: round $error 55% !important; }
Button.-primary:hover, Button.-primary:focus { border: round $primary 70% !important; }
Button.-success:hover, Button.-success:focus { border: round $success 70% !important; }
Button.-warning:hover, Button.-warning:focus { border: round $warning 70% !important; }
Button.-error:hover, Button.-error:focus { border: round $error 70% !important; }
Button.-active { background: $surface !important; tint: $background 0%; }
Button:disabled, Button:disabled:hover, Button:disabled:focus {
    background: $surface !important;
    border: round $foreground 10% !important;
    color: $text-muted;
    text-style: none;
    text-opacity: 0.5;
}

/* Mouse hover stays quieter than the keyboard cursor. */
DataTable > .datatable--hover,
DataTable > .datatable--header-hover,
OptionList > .option-list--option-hover {
    background: $foreground 5%;
}

/* ── Workspace toolbar ────────────────────────────────────────────────────── */
#toolbar { height: 3; padding: 0 1; }
#account-picker { width: 22; margin-right: 1; }
#run-picker { width: 1fr; min-width: 20; }
#toolbar Button { min-width: 9; width: auto; margin-left: 1; }
#account-connection { height: 1; margin: 0 2; color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
#account-connection.connection-connected { color: $text-success; }
#account-connection.connection-error { color: $text-warning; }

/* ── Workspace body ───────────────────────────────────────────────────────── */
#workspace { height: 1fr; }
#main { width: 1fr; padding: 0 1; }
#filters { height: 3; }
#search { width: 2fr; margin-right: 1; }
#class-filter, #status-filter { width: 1fr; min-width: 14; margin-right: 1; }
#confidence-group { width: 22; height: 3; }
#confidence-op { width: 8; }
#confidence-val { width: 1fr; min-width: 10; }
#selection-tools { height: 3; margin: 1 0; }
#selection-tools Button { width: auto; min-width: 8; padding: 0 1; margin-right: 1; }
#selection-summary { width: 1fr; min-width: 0; padding: 1 1; color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
#toggle-detail { display: none; }
#email-panes { height: 1fr; }
#email-table { width: 1fr; height: 1fr; border: solid $primary; }
#email-detail { display: none; width: 1fr; height: 1fr; padding: 0 1; border: solid $primary; }
#selection-tools #open-detail { width: 15; min-width: 15; max-width: 15; }
.show-detail #email-table { display: none; }
.show-detail #email-detail { display: block; }
#email-heading { height: auto; max-height: 6; }
#email-warnings { height: auto; max-height: 4; color: $warning; }
#body-label { height: 1; color: $text-muted; }
#email-content { height: 1fr; min-height: 8; }

/* ── Narrow / responsive ──────────────────────────────────────────────────── */
.narrow #toolbar { height: 6; layout: grid; grid-size: 3 2; grid-columns: 1fr 1fr 1fr; grid-rows: 3 3; grid-gutter: 0 1; }
.narrow #account-picker { width: 1fr; margin-right: 0; }
.narrow #run-picker { width: 1fr; min-width: 0; column-span: 2; }
.narrow #toolbar Button { width: 1fr; min-width: 0; margin-left: 0; padding: 0; }
.narrow #selection-summary { display: none; }
.narrow #selection-tools { height: 6; layout: grid; grid-size: 4 2; grid-columns: 1fr 1fr 1fr 1fr; grid-rows: 3 3; grid-gutter: 0 1; }
.narrow #selection-tools Button { width: 1fr; min-width: 0; margin-right: 0; padding: 0; }
.narrow #selection-tools #open-detail { width: 1fr; min-width: 0; max-width: 100%; }
.narrow #filters { height: 9; layout: grid; grid-size: 2 3; grid-rows: 3 3 3; }
.narrow #search { column-span: 2; width: 1fr; }
.narrow #confidence-group { column-span: 2; width: 1fr; }

/* ── Jobs monitor panel ───────────────────────────────────────────────────── */
#jobs-panel { display: none; height: auto; max-height: 8; border-top: solid $warning; background: $surface; }
.jobs-active #jobs-panel { display: block; }
#jobs-panel-title { height: 1; padding: 0 1; background: $warning 30%; color: $warning; text-style: bold; }
#jobs-list { height: auto; max-height: 7; padding: 0 1; }
.job-row { height: 1; margin-bottom: 0; }
.job-status-text { width: 1fr; }
.job-stop-btn { width: auto; min-width: 6; height: 1; min-height: 1; padding: 0 1; }
Button.job-stop-btn, Button.job-stop-btn:hover, Button.job-stop-btn:focus, Button.job-stop-btn.-active { border: none !important; }

/* ── Activity log ─────────────────────────────────────────────────────────── */
#log-panel { display: none; height: 10; max-height: 40%; border-top: solid $primary; }
.log-open #log-panel { display: block; }
#log-title { height: 1; padding: 0 1; }
#activity-log { height: 1fr; padding: 0 1; border: none; }

/* ── Dialogs ──────────────────────────────────────────────────────────────── */
Dialog { align: center middle; background: $background 70%; }
.dialog { width: 76; max-width: 95%; height: auto; max-height: 95%; padding: 1 2; border: thick $primary; background: $surface; overflow-y: auto; }
.dialog-title { text-style: bold; height: auto; margin-bottom: 1; }
.dialog Label { margin-top: 1; }
#scan-skip-processed { margin-top: 1; }
.dialog-buttons { height: 3; margin-top: 1; }
.dialog-buttons Button { width: 1fr; margin-right: 1; }
#apply-dialog { height: 80%; }
#folder-dialog { height: 90%; }
#folder-content { height: 1fr; }
#folder-status { height: auto; max-height: 4; margin-top: 1; }
#apply-actions { height: 1fr; min-height: 4; }

/* ── Runs tab ─────────────────────────────────────────────────────────────── */
RunsScreen { height: 1fr; layout: vertical; }
#runs-page { height: 1fr; padding: 1 2; layout: vertical; }
#runs-table { height: 1fr; margin: 1 0; border: solid $primary; }
.page-title { text-style: bold; height: 3; }
.page-actions { height: 3; }
.page-actions Button { width: auto; min-width: 14; margin-right: 1; }
#runs-status, #accounts-status { height: 2; padding: 0 1; }

/* ── Accounts tab ─────────────────────────────────────────────────────────── */
AccountsScreen { height: 1fr; layout: vertical; }
#accounts-page { height: 1fr; padding: 1 2; layout: vertical; }
#account-manager { height: 1fr; }
#account-form-panel { width: 2fr; padding: 1; border: solid $primary; }
#account-summary { height: auto; padding: 1; }
#account-actions { width: 1fr; padding: 1; }
#account-actions Button { width: 1fr; margin-bottom: 1; }
#account-help { height: auto; padding: 1; color: $text-muted; }

/* ── Classes tab ─────────────────────────────────────────────────────────── */
ClassesScreen { height: 1fr; layout: vertical; }
#classes-page { height: 1fr; padding: 1 2; layout: vertical; }
#classes-list { width: 1fr; height: 1fr; margin: 1 1 1 0; border: solid $primary; }
#classes-manager { height: 1fr; }
#classes-actions { width: 26; padding: 1; border: solid $primary; }
#classes-actions Button { width: 1fr; margin-bottom: 1; }
#classes-status { height: 2; padding: 0 1; }
#class-edit-dialog { width: 78; max-width: 95%; }
#class-edit-dialog Input, #class-edit-dialog Select { width: 1fr; }

/* ── Settings tab ─────────────────────────────────────────────────────────── */
SettingsScreen { height: 1fr; layout: vertical; }
#settings-page { height: 1fr; layout: vertical; }
#settings-content { height: 1fr; padding: 1 2; }
.settings-heading { text-style: bold; height: 2; margin-top: 1; }
#settings-content Label { margin-top: 1; }
#settings-content Input, #settings-content Select { width: 1fr; max-width: 80; }
#settings-help { color: $text-muted; margin-top: 1; height: auto; max-width: 90; }
#settings-status { height: auto; max-height: 5; margin: 0 2; overflow-y: auto; }

/* ── Unsubscribe tab ──────────────────────────────────────────────────────── */
UnsubscribeScreen { height: 1fr; layout: vertical; }
#unsubscribe-page { height: 1fr; padding: 1 2; layout: vertical; }
#unsubscribe-toolbar { height: 3; margin: 1 0; }
#unsubscribe-account { width: 22; margin-right: 1; }
#unsubscribe-run { width: 1fr; }
#unsubscribe-toolbar Button { width: auto; min-width: 12; margin-left: 1; }
#unsubscribe-table { height: 1fr; margin: 0 0 1 0; border: solid $primary; }
#unsubscribe-help { height: auto; min-height: 2; max-height: 3; color: $text-muted; }
#unsubscribe-status { height: 2; padding: 0 1; }
#unsubscribe-confirm { width: 84; max-width: 95%; }
#unsubscribe-email-dialog { width: 100; max-width: 95%; height: 85%; max-height: 95%; }
#unsubscribe-email-detail { display: block; height: 1fr; width: 1fr; padding: 0 1; border: solid $primary; }

/* ── Run logs dialog ──────────────────────────────────────────────────────── */
#run-logs-dialog { width: 90; max-width: 95%; height: 85%; max-height: 95%; }
#run-logs-scroll { height: 1fr; margin: 1 0; border: solid $primary; padding: 1; overflow-y: auto; }
#run-logs-content { height: auto; min-height: 100%; border: none; }

/* Saved run encryption */
#run-encryption-control { height: 1; margin-bottom: 1; align-vertical: middle; }
#run-encryption-control Label { width: auto; margin-top: 0; margin-right: 2; }
#encrypt-runs {
    width: 6;
    height: 1;
    padding: 0 1;
    border: none !important;
    background: $surface;
    background-tint: $background 0%;
}
#encrypt-runs > .switch--slider { color: $foreground 35%; background: $foreground 8%; }
#encrypt-runs:hover > .switch--slider { color: $foreground 50%; }
#encrypt-runs:focus > .switch--slider { color: $foreground 70%; }
#encrypt-runs.-on > .switch--slider { color: $text-success; background: $success 12%; }
#encrypt-runs.-on:hover > .switch--slider, #encrypt-runs.-on:focus > .switch--slider { color: $success; background: $success 20%; }
#run-encryption-state { width: auto; height: 1; margin-left: 1; color: $text-muted; }
#run-encryption-state.is-on { color: $text-success; }
#run-encryption-help { height: auto; max-width: 90; color: $text-muted; margin-bottom: 1; }
#run-password-error { height: auto; min-height: 1; color: $warning; margin-top: 1; }

/* Ollama model selection */
.model-picker { height: auto; margin-bottom: 1; }
.model-picker-controls { height: 3; max-width: 95; }
#settings-content .model-picker-controls Select { width: 1fr; max-width: 80; }
.model-picker-controls Button { width: auto; min-width: 14; margin-left: 1; }
.custom-model-field { height: auto; }
.model-picker-status, .model-help { height: auto; max-width: 95; color: $text-muted; }
.model-picker-status { margin-top: 1; }
