  "scripts": {
    "render:video": "remotion render InboxedShowcase out/inboxed-master.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=128k --jpeg-quality=95 --concurrency=2",
